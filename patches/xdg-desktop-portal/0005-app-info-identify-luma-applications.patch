diff --git a/src/xdp-app-info-luma.c b/src/xdp-app-info-luma.c
new file mode 100644
index 0000000..6c17eb2
--- /dev/null
+++ b/src/xdp-app-info-luma.c
@@ -0,0 +1,177 @@
+/*
+ * Copyright © 2026 Project Luma
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * Applications Luma installs from package files (store trees, capsules,
+ * AppImages) run in their own sandbox under an SELinux category pair
+ * allocated to them, in the luma_application.process domain, and in their
+ * own app-luma-NAME-PID.scope. They are sandboxed applications: permissions
+ * are looked up and stored under their ID, and files they are given go
+ * through the document portal.
+ *
+ * The ID comes from Luma's one resolver, org.projectluma.AppPermissions1
+ * Identify(pid) (luma_installer.app_identity), which follows the same rules
+ * as the compositor (Mutter 0041): the level names the application's record,
+ * the scope names it when there is no level. It is the desktop-file ID of the
+ * launcher Luma wrote, org.projectluma.Installed.ID, so a prompt shows that
+ * application's name and icon. A process in the domain that cannot be named
+ * is refused rather than treated as the host.
+ */
+
+#include "config.h"
+
+#include "xdp-app-info-luma-private.h"
+
+#include <gio/gio.h>
+#include <string.h>
+
+#define LUMA_ENGINE_ID "org.projectluma"
+#define LUMA_DOMAIN ":luma_application.process:"
+#define LUMA_PERMISSIONS_NAME "org.projectluma.AppPermissions1"
+#define LUMA_PERMISSIONS_PATH "/org/projectluma/AppPermissions"
+
+struct _XdpAppInfoLuma
+{
+  XdpAppInfo parent;
+};
+
+G_DEFINE_FINAL_TYPE (XdpAppInfoLuma, xdp_app_info_luma, XDP_TYPE_APP_INFO);
+
+static char *
+read_proc (int         pid,
+           const char *name)
+{
+  g_autofree char *path = g_strdup_printf ("/proc/%d/%s", pid, name);
+  char *contents = NULL;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return NULL;
+
+  return contents;
+}
+
+/* In the Luma application domain, or started in a Luma launcher's scope. */
+static gboolean
+is_luma_application (int pid)
+{
+  g_autofree char *label = read_proc (pid, "attr/current");
+  g_autofree char *cgroup = NULL;
+  g_auto(GStrv) lines = NULL;
+  size_t i;
+
+  if (label && strstr (label, LUMA_DOMAIN) != NULL)
+    return TRUE;
+
+  cgroup = read_proc (pid, "cgroup");
+  if (!cgroup)
+    return FALSE;
+
+  lines = g_strsplit (cgroup, "\n", -1);
+  for (i = 0; lines[i]; i++)
+    {
+      const char *leaf;
+
+      if (!g_str_has_prefix (lines[i], "0::"))
+        continue;
+      leaf = strrchr (lines[i], '/');
+      leaf = leaf ? leaf + 1 : lines[i] + 3;
+      if (g_str_has_prefix (leaf, "app-luma-") && g_str_has_suffix (leaf, ".scope"))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+xdp_app_info_luma_class_init (XdpAppInfoLumaClass *klass)
+{
+}
+
+static void
+xdp_app_info_luma_init (XdpAppInfoLuma *app_info_luma)
+{
+}
+
+XdpAppInfo *
+xdp_app_info_luma_new (const char *sender,
+                       int         pid,
+                       int        *pidfd,
+                       GError    **error)
+{
+  g_autoptr(GDBusConnection) bus = NULL;
+  g_autoptr(GVariant) reply = NULL;
+  g_autoptr(GError) local_error = NULL;
+  g_autofree char *instance = NULL;
+  const char *test_app_info_kind;
+  const char *app_id = NULL;
+  const char *kind = NULL;
+
+  test_app_info_kind = g_getenv ("XDG_DESKTOP_PORTAL_TEST_APP_INFO_KIND");
+  if (test_app_info_kind && g_strcmp0 (test_app_info_kind, "luma") != 0)
+    {
+      g_set_error (error, XDP_APP_INFO_ERROR, XDP_APP_INFO_ERROR_WRONG_APP_KIND,
+                   "Testing requested different AppInfo kind: %s",
+                   test_app_info_kind);
+      return NULL;
+    }
+
+  if (!is_luma_application (pid))
+    {
+      g_set_error (error, XDP_APP_INFO_ERROR, XDP_APP_INFO_ERROR_WRONG_APP_KIND,
+                   "Not a Luma application");
+      return NULL;
+    }
+
+  bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &local_error);
+  if (bus)
+    reply = g_dbus_connection_call_sync (bus,
+                                         LUMA_PERMISSIONS_NAME,
+                                         LUMA_PERMISSIONS_PATH,
+                                         LUMA_PERMISSIONS_NAME,
+                                         "Identify",
+                                         g_variant_new ("(u)", (guint32) pid),
+                                         G_VARIANT_TYPE ("(ss)"),
+                                         G_DBUS_CALL_FLAGS_NONE,
+                                         5000,
+                                         NULL,
+                                         &local_error);
+  if (!reply)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                   "Luma could not name this application: %s",
+                   local_error ? local_error->message : "no reply");
+      return NULL;
+    }
+
+  g_variant_get (reply, "(&s&s)", &app_id, &kind);
+
+  /* A host process in a scope of that name (a shell started from a
+   * terminal Luma launched, say) is the host. */
+  if (g_strcmp0 (kind, "host") == 0)
+    {
+      g_set_error (error, XDP_APP_INFO_ERROR, XDP_APP_INFO_ERROR_WRONG_APP_KIND,
+                   "Not a Luma application");
+      return NULL;
+    }
+
+  if (g_strcmp0 (kind, "luma") != 0 || app_id == NULL || *app_id == '\0' ||
+      !g_application_id_is_valid (app_id))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                   "Luma could not name this application");
+      return NULL;
+    }
+
+  instance = g_strdup_printf ("%d", pid);
+
+  return g_initable_new (XDP_TYPE_APP_INFO_LUMA,
+                         NULL,
+                         error,
+                         "engine", LUMA_ENGINE_ID,
+                         "flags", XDP_APP_INFO_FLAG_HAS_NETWORK,
+                         "id", app_id,
+                         "instance", instance,
+                         "sender", sender,
+                         NULL);
+}
