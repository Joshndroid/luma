 fixture_test = executable(
   'test-luma-fixture',
   ['test-luma-fixture.c', 'cc-luma-fixture.c', 'cc-luma-bluetooth.c', 'cc-luma-desktop.c', 'cc-luma-discovery.c', 'cc-luma-displays.c', 'cc-luma-sound.c', 'cc-luma-device-options.c', 'cc-luma-privacy.c', 'cc-luma-keyboard.c', 'cc-luma-application-options.c'],
diff --git a/shell/test-luma-window.c b/shell/test-luma-window.c
new file mode 100644
index 0000000..0a4e8f0
--- /dev/null
+++ b/shell/test-luma-window.c
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Settings' window on a computer at phone width: the list first, as on a phone; wider, the two panes. */
+#include "config.h"
+#include <adwaita.h>
+#include <luma-ui.h>
+#include "cc-luma-fixture.h"
+#include "cc-luma-shell.h"
+#include "cc-luma-view.h"
+#include "cc-luma-window.h"
+
+static gboolean done (gpointer data) { *(gboolean *) data = TRUE; return G_SOURCE_REMOVE; }
+static void wait_ms (guint ms)
+{
+  gboolean over = FALSE;
+  g_timeout_add (ms, done, &over);
+  while (!over) g_main_context_iteration (NULL, TRUE);
+}
+
+static GtkListBoxRow *row_for (GtkWidget *root, const char *page)
+{
+  if (GTK_IS_LIST_BOX_ROW (root) && g_strcmp0 (g_object_get_data (G_OBJECT (root), "cf-page"), page) == 0)
+    return GTK_LIST_BOX_ROW (root);
+  for (GtkWidget *c = gtk_widget_get_first_child (root); c; c = gtk_widget_get_next_sibling (c))
+    {
+      GtkListBoxRow *row = row_for (c, page);
+      if (row) return row;
+    }
+  return NULL;
+}
+
+static void pick (GtkWidget *window, const char *page)
+{
+  GtkListBoxRow *row = row_for (window, page);
+  g_assert_nonnull (row);
+  g_signal_emit_by_name (gtk_widget_get_parent (GTK_WIDGET (row)), "row-activated", row);
+  wait_ms (400);
+}
+
+static const char *page_of (GtkWidget *window)
+{
+  return cc_luma_shell_get_page (CC_LUMA_SHELL (g_object_get_data (G_OBJECT (window), "cf-shell")));
+}
+
+static GtkWidget *body_of (GtkWidget *window)
+{
+  return luma_application_window_get_body (LUMA_APPLICATION_WINDOW (window));
+}
+
+static void resize (GtkWidget *window, int width)
+{
+  gtk_window_set_default_size (GTK_WINDOW (window), width, 844);
+  wait_ms (500);
+}
+
+static void assert_list_first (GtkWidget *window, const char *showing)
+{
+  GtkWidget *body = body_of (window);
+  g_assert_true (LUMA_IS_LIST_FIRST (body));
+  g_assert_true (luma_list_first_get_phone (LUMA_LIST_FIRST (body)));
+  g_assert_cmpstr (luma_list_first_get_showing (LUMA_LIST_FIRST (body)), ==, showing);
+}
+
+static void assert_two_panes (GtkWidget *window)
+{
+  GtkWidget *body = body_of (window);
+  GtkWidget *sidebar = gtk_widget_get_ancestor (GTK_WIDGET (row_for (window, "wifi")), LUMA_TYPE_NAVIGATION_SIDEBAR);
+  GtkWidget *island = gtk_widget_get_ancestor (g_object_get_data (G_OBJECT (window), "cf-shell"), LUMA_TYPE_ISLAND);
+  g_assert_false (LUMA_IS_LIST_FIRST (body));
+  g_assert_true (gtk_widget_get_parent (sidebar) == body);
+  g_assert_true (gtk_widget_get_parent (island) == body);
+  g_assert_true (gtk_widget_get_mapped (sidebar));
+  g_assert_true (gtk_widget_get_mapped (island));
+}
+
+static GtkWidget *open_window (GtkApplication *app, CcLumaFixture *model, int width)
+{
+  GtkWidget *view = cc_luma_view_new (model, "wifi", NULL);
+  g_assert_nonnull (view);
+  GtkWidget *window = cc_luma_window_new (app, model, view);
+  gtk_window_set_default_size (GTK_WINDOW (window), width, 844);
+  gtk_window_present (GTK_WINDOW (window));
+  wait_ms (800);
+  return window;
+}
+
+static GtkApplication *app;
+
+static void narrow_computer (void)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (CcLumaFixture) model = cc_luma_fixture_load (g_getenv ("LUMA_SETTINGS_TEST_FIXTURE"), &error);
+  g_assert_no_error (error);
+
+  /* Opened at phone width: the list is the screen. */
+  GtkWidget *window = open_window (app, model, 400);
+  int min = 0;
+  /* The window may be as narrow as a phone: its content asks for no more than the screen has. */
+  gtk_widget_measure (adw_application_window_get_content (ADW_APPLICATION_WINDOW (window)),
+                      GTK_ORIENTATION_HORIZONTAL, -1, &min, NULL, NULL, NULL);
+  g_assert_cmpint (min, <=, 400);
+  assert_list_first (window, "list");
+
+  /* A pick pushes its page; Back returns to the list. */
+  pick (window, "sound");
+  assert_list_first (window, "detail");
+  g_assert_cmpstr (page_of (window), ==, "sound");
+  luma_list_first_show_list (LUMA_LIST_FIRST (body_of (window)));
+  wait_ms (400);
+  assert_list_first (window, "list");
+  pick (window, "apps");
+  assert_list_first (window, "detail");
+  g_assert_cmpstr (page_of (window), ==, "apps");
+
+  /* Wider: the two panes, on the same page. */
+  resize (window, 1180);
+  assert_two_panes (window);
+  g_assert_cmpstr (page_of (window), ==, "apps");
+  pick (window, "wifi");
+  g_assert_cmpstr (page_of (window), ==, "wifi");
+
+  /* Narrow again: the page it was on, Back to the list. */
+  resize (window, 400);
+  assert_list_first (window, "detail");
+  g_assert_cmpstr (page_of (window), ==, "wifi");
+  luma_list_first_show_list (LUMA_LIST_FIRST (body_of (window)));
+  wait_ms (400);
+  assert_list_first (window, "list");
+
+  /* A tiled half of a small screen keeps both panes. */
+  resize (window, 720);
+  assert_two_panes (window);
+  gtk_window_destroy (GTK_WINDOW (window));
+  wait_ms (100);
+
+  /* A computer's window opens with both panes. */
+  window = open_window (app, model, 1180);
+  assert_two_panes (window);
+  gtk_window_destroy (GTK_WINDOW (window));
+  wait_ms (100);
+}
+
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_unsetenv ("LUMA_FORM_FACTOR");
+  g_unsetenv ("LUMA_SETTINGS_PAGE");
+  g_setenv ("LUMA_DEVICE_CLASS", "desktop", TRUE);
+  g_setenv ("LUMA_POSTURE", "desktop", TRUE);
+  app = gtk_application_new ("org.luma.Settings.WindowTest", G_APPLICATION_NON_UNIQUE);
+  g_assert_true (g_application_register (G_APPLICATION (app), NULL, NULL));
+  luma_init ();
+  g_test_add_func ("/settings/window/narrow-computer", narrow_computer);
+  int status = g_test_run ();
+  g_object_unref (app);
+  return status;
+}
