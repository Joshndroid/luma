diff --git a/js/ui/lumaSession.js b/js/ui/lumaSession.js
new file mode 100644
index 0000000..502e3a9
--- /dev/null
+++ b/js/ui/lumaSession.js
@@ -0,0 +1,1029 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The session survives log-out, restarts and crashes, and follows the person
+// to their other devices (ADR-055, docs/decisions/055-continue.md).
+//
+// A snapshot is every application window in stacking order: its app, key,
+// monitor, workspace, frame and floating rectangles (absolute and as a share
+// of the monitor's work area), state, focus, and the state LumaUI apps give
+// for it. Restoring starts the apps and places each window in its first
+// configure (MetaWindow::configure), before Mutter places or shows it; when
+// the windows are there, stacking, minimized windows, the workspace and
+// focus follow. Snapshots live in $XDG_STATE_HOME/luma/session (0700/0600).
+//
+//   journalctl --user -b -g luma-session
+
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import Meta from 'gi://Meta';
+import Shell from 'gi://Shell';
+
+import * as LoginManager from '../misc/loginManager.js';
+import * as Main from './main.js';
+import * as MessageTray from './messageTray.js';
+
+export const FORMAT = 1;
+const SCHEMA = 'org.projectluma.session';
+const PERIODIC_MS = 60 * 1000;
+const SETTLE_MS = 3000;
+const RESTORE_WAIT_MS = 20 * 1000;
+const LATE_WINDOW_MS = 15 * 60 * 1000;
+const SAVE_TIMEOUT_MS = 500;
+const MORE_WINDOWS_MS = 1500;
+const SLEEP_BUDGET_MS = 2000;
+const CONTINUE_TTL_S = 72 * 3600;
+
+const SessionIface = `<node>
+  <interface name="org.projectluma.Session1">
+    <method name="TakeRestore">
+      <arg type="s" name="app_id" direction="in"/>
+      <arg type="s" name="reason" direction="out"/>
+      <arg type="v" name="state" direction="out"/>
+    </method>
+    <method name="SetWindowKey">
+      <arg type="o" name="window" direction="in"/>
+      <arg type="s" name="key" direction="in"/>
+    </method>
+    <method name="SaveState">
+      <arg type="u" name="serial" direction="in"/>
+      <arg type="v" name="state" direction="in"/>
+    </method>
+    <signal name="SaveRequested">
+      <arg type="u" name="serial"/>
+    </signal>
+    <method name="Snapshot">
+      <arg type="s" name="reason" direction="in"/>
+      <arg type="s" name="snapshot" direction="out"/>
+    </method>
+    <method name="GetSnapshot">
+      <arg type="s" name="snapshot" direction="out"/>
+    </method>
+    <method name="Restore">
+      <arg type="s" name="snapshot" direction="in"/>
+      <arg type="s" name="mode" direction="in"/>
+      <arg type="s" name="result" direction="out"/>
+    </method>
+    <signal name="SnapshotTaken">
+      <arg type="s" name="reason"/>
+    </signal>
+    <signal name="RestoreFinished">
+      <arg type="s" name="result"/>
+    </signal>
+  </interface>
+</node>`;
+
+const BUS_NAME = 'org.projectluma.Session';
+const OBJECT_PATH = '/org/projectluma/Session';
+
+function log(message) {
+    console.log(`[luma-session] ${message}`);
+}
+
+export function stateDir() {
+    return GLib.build_filenamev([GLib.get_user_state_dir(), 'luma', 'session']);
+}
+
+function machineId() {
+    try {
+        const [, bytes] = GLib.file_get_contents('/etc/machine-id');
+        return new TextDecoder().decode(bytes).trim();
+    } catch {
+        return '';
+    }
+}
+
+function rect(r) {
+    return {x: r.x, y: r.y, width: r.width, height: r.height};
+}
+
+function share(r, area) {
+    return {
+        x: (r.x - area.x) / Math.max(1, area.width),
+        y: (r.y - area.y) / Math.max(1, area.height),
+        width: r.width / Math.max(1, area.width),
+        height: r.height / Math.max(1, area.height),
+    };
+}
+
+function unshare(s, area) {
+    return {
+        x: Math.round(area.x + s.x * area.width),
+        y: Math.round(area.y + s.y * area.height),
+        width: Math.round(s.width * area.width),
+        height: Math.round(s.height * area.height),
+    };
+}
+
+// Keep a rectangle inside the work area without making it smaller than it
+// has to be.
+export function fit(r, area) {
+    const width = Math.min(r.width, area.width);
+    const height = Math.min(r.height, area.height);
+    const x = Math.min(Math.max(r.x, area.x), area.x + area.width - width);
+    const y = Math.min(Math.max(r.y, area.y), area.y + area.height - height);
+    return {x, y, width, height};
+}
+
+function sameArea(a, b) {
+    return a && b && a.x === b.x && a.y === b.y && a.width === b.width && a.height === b.height;
+}
+
+// Saved monitor index -> current monitor index. Identity (vendor, product,
+// serial) first, then the built-in to the built-in, then the same place
+// relative to the primary monitor, then the primary monitor.
+export function mapMonitors(saved, current) {
+    const used = new Set();
+    const map = new Map();
+    const identity = m => m.vendor || m.product || m.serial
+        ? `${m.vendor}|${m.product}|${m.serial}` : null;
+    for (const s of saved) {
+        const match = current.find(c => !used.has(c.index) && identity(c) && identity(c) === identity(s));
+        if (match) {
+            map.set(s.index, match.index);
+            used.add(match.index);
+        }
+    }
+    for (const s of saved.filter(m => !map.has(m.index) && m.builtin)) {
+        const match = current.find(c => !used.has(c.index) && c.builtin);
+        if (match) {
+            map.set(s.index, match.index);
+            used.add(match.index);
+        }
+    }
+    const primarySaved = saved.find(m => m.primary) ?? saved[0];
+    const primaryCurrent = current.find(c => c.primary) ?? current[0];
+    for (const s of saved.filter(m => !map.has(m.index))) {
+        const dx = Math.sign(s.x - (primarySaved?.x ?? 0));
+        const dy = Math.sign(s.y - (primarySaved?.y ?? 0));
+        const match = current.find(c => !used.has(c.index) &&
+            Math.sign(c.x - primaryCurrent.x) === dx && Math.sign(c.y - primaryCurrent.y) === dy);
+        if (match) {
+            map.set(s.index, match.index);
+            used.add(match.index);
+        } else {
+            map.set(s.index, primaryCurrent?.index ?? 0);
+        }
+    }
+    return map;
+}
+
+const STATES = ['floating', 'maximized', 'tiled-left', 'tiled-right', 'fullscreen'];
+
+function windowState(window) {
+    if (window.is_fullscreen())
+        return 'fullscreen';
+    if (window.is_maximized())
+        return 'maximized';
+    const flags = window.get_maximize_flags?.() ?? 0;
+    if (flags === Meta.MaximizeFlags.VERTICAL) {
+        // A window tiled to a side is maximized vertically and half wide.
+        const area = window.get_work_area_current_monitor();
+        const frame = window.get_frame_rect();
+        if (frame.x <= area.x + 1)
+            return 'tiled-left';
+        if (frame.x + frame.width >= area.x + area.width - 1)
+            return 'tiled-right';
+    }
+    return 'floating';
+}
+
+function floatingRect(window) {
+    if (window.get_floating_rect)
+        return window.get_floating_rect();
+    return window.get_frame_rect();
+}
+
+// The windows a person would expect back: their own application windows,
+// not dialogs (the app re-creates those), menus or the shell's own.
+export function isRestorable(window) {
+    if (window.is_override_redirect() || window.get_transient_for())
+        return false;
+    if (window.get_window_type() !== Meta.WindowType.NORMAL)
+        return false;
+    if (window.is_skip_taskbar())
+        return false;
+    return true;
+}
+
+function windowIds(window) {
+    return {
+        sandboxed: window.get_sandboxed_app_id() ?? '',
+        gtk: window.get_gtk_application_id() ?? '',
+        wmClass: window.get_wm_class() ?? '',
+        wmInstance: window.get_wm_class_instance() ?? '',
+    };
+}
+
+function appIdOf(window) {
+    const app = Shell.WindowTracker.get_default().get_window_app(window);
+    if (app && !app.is_window_backed())
+        return app.get_id();
+    return null;
+}
+
+// The ids a window could be known by, in the forms a desktop ID takes.
+function candidateAppIds(window) {
+    const ids = new Set();
+    const tracked = appIdOf(window);
+    if (tracked)
+        ids.add(tracked);
+    const {sandboxed, gtk, wmClass, wmInstance} = windowIds(window);
+    for (const id of [sandboxed, gtk, wmClass, wmInstance]) {
+        if (!id)
+            continue;
+        ids.add(`${id}.desktop`);
+        ids.add(`${id.toLowerCase()}.desktop`);
+    }
+    return ids;
+}
+
+function variantToText(variant) {
+    return variant ? variant.print(true) : null;
+}
+
+function textToVariant(text) {
+    if (!text)
+        return null;
+    try {
+        return GLib.Variant.parse(null, text, null, null);
+    } catch (e) {
+        log(`unreadable app state: ${e.message}`);
+        return null;
+    }
+}
+
+function readJson(path) {
+    try {
+        const [, bytes] = GLib.file_get_contents(path);
+        return JSON.parse(new TextDecoder().decode(bytes));
+    } catch {
+        return null;
+    }
+}
+
+function writePrivate(path, text) {
+    GLib.mkdir_with_parents(GLib.path_get_dirname(path), 0o700);
+    const file = Gio.File.new_for_path(path);
+    file.replace_contents(new TextEncoder().encode(text), null, false,
+        Gio.FileCreateFlags.PRIVATE | Gio.FileCreateFlags.REPLACE_DESTINATION, null);
+}
+
+function decodeScope(text) {
+    return text.replace(/\\x([0-9a-f]{2})/gi, (_m, hex) => String.fromCharCode(parseInt(hex, 16)));
+}
+
+// Who a D-Bus caller is: its process, whether it is sandboxed (another mount
+// namespace: Flatpak, ADR-052 app sandboxes) and the app its scope or its
+// Flatpak instance names.
+async function callerIdentity(sender) {
+    const [pid] = (await Gio.DBus.session.call('org.freedesktop.DBus', '/org/freedesktop/DBus',
+        'org.freedesktop.DBus', 'GetConnectionUnixProcessID', new GLib.Variant('(s)', [sender]),
+        new GLib.VariantType('(u)'), Gio.DBusCallFlags.NONE, -1, null)).deepUnpack();
+    let sandboxed = false;
+    try {
+        sandboxed = GLib.file_read_link(`/proc/${pid}/ns/mnt`) !== GLib.file_read_link('/proc/self/ns/mnt');
+    } catch {
+        sandboxed = true;
+    }
+    let appId = null;
+    try {
+        const info = new GLib.KeyFile();
+        info.load_from_file(`/proc/${pid}/root/.flatpak-info`, GLib.KeyFileFlags.NONE);
+        appId = info.get_string('Application', 'name');
+    } catch {}
+    if (!appId) {
+        try {
+            const [, bytes] = GLib.file_get_contents(`/proc/${pid}/cgroup`);
+            const text = new TextDecoder().decode(bytes);
+            const match = text.match(/app-(?:gnome|flatpak|luma)-(.+?)-[0-9a-z]+\.scope/);
+            if (match)
+                appId = decodeScope(match[1]).replace(/\.desktop$/, '');
+        } catch {}
+    }
+    return {pid, sandboxed, appId};
+}
+
+function sameApp(a, b) {
+    const norm = id => (id ?? '').replace(/\.desktop$/, '').toLowerCase();
+    return norm(a) !== '' && norm(a) === norm(b);
+}
+
+export class LumaSession {
+    constructor() {
+        this._settings = null;
+        try {
+            this._settings = new Gio.Settings({schema_id: SCHEMA});
+        } catch (e) {
+            log(`no ${SCHEMA} schema: ${e.message}`);
+        }
+        this._dir = stateDir();
+        this._device = machineId();
+        this._dirty = false;
+        this._frozen = false;
+        this._lastWrite = 0;
+        this._writeId = 0;
+        this._serial = 0;
+        this._clients = new Map();      // bus name -> {appId, watch}
+        this._keys = new Map();         // `${bus}|${path}` -> key
+        this._answers = null;           // serial -> Map(bus -> state)
+        this._pendingRestore = new Map(); // app id (normalised) -> {reason, state}
+        this._restoring = null;
+
+        this._dbusImpl = Gio.DBusExportedObject.wrapJSObject(SessionIface, this);
+        this._dbusImpl.export(Gio.DBus.session, OBJECT_PATH);
+        this._nameId = Gio.bus_own_name_on_connection(Gio.DBus.session, BUS_NAME,
+            Gio.BusNameOwnerFlags.NONE, null, null);
+
+        this._watchWindows();
+        this._watchSession();
+
+        if (Main.layoutManager._startingUp)
+            Main.layoutManager.connectObject('startup-complete', () => this._restoreAtLogin(), this);
+        else
+            GLib.idle_add(GLib.PRIORITY_DEFAULT, () => {
+                this._restoreAtLogin();
+                return GLib.SOURCE_REMOVE;
+            });
+    }
+
+    get reopenWindows() {
+        return this._settings?.get_boolean('reopen-windows') ?? true;
+    }
+
+    // --- snapshots -------------------------------------------------------
+
+    _monitors() {
+        const manager = global.backend.get_monitor_manager();
+        const logical = manager.get_logical_monitors();
+        const workspace = global.workspace_manager.get_active_workspace();
+        return Main.layoutManager.monitors.map(monitor => {
+            const lm = logical.find(l => l.get_number() === monitor.index);
+            const hw = lm?.get_monitors()?.[0] ?? null;
+            const area = workspace.get_work_area_for_monitor(monitor.index);
+            return {
+                index: monitor.index,
+                connector: hw?.get_connector() ?? '',
+                vendor: hw?.get_vendor() ?? '',
+                product: hw?.get_product() ?? '',
+                serial: hw?.get_serial() ?? '',
+                builtin: hw?.is_builtin() ?? false,
+                primary: monitor.index === Main.layoutManager.primaryIndex,
+                x: monitor.x, y: monitor.y, width: monitor.width, height: monitor.height,
+                scale: monitor.geometry_scale,
+                workArea: rect(area),
+            };
+        });
+    }
+
+    _windows() {
+        const excluded = new Set(this._settings?.get_strv('excluded-apps') ?? []);
+        const all = global.display.list_all_windows().filter(w => isRestorable(w) &&
+            !excluded.has(appIdOf(w)));
+        return global.display.sort_windows_by_stacking(all);
+    }
+
+    _describe(window, monitors, focus) {
+        const monitorIndex = window.get_monitor();
+        const area = monitors[monitorIndex]?.workArea ?? rect(window.get_work_area_current_monitor());
+        const frame = rect(window.get_frame_rect());
+        const floating = rect(floatingRect(window));
+        const workspace = window.is_on_all_workspaces() ? -1 : window.get_workspace()?.index() ?? 0;
+        const bus = window.get_gtk_unique_bus_name();
+        const path = window.get_gtk_window_object_path();
+        const key = (bus && path && this._keys.get(`${bus}|${path}`)) || window.get_tag() || null;
+        return {
+            app: appIdOf(window),
+            ids: windowIds(window),
+            kind: window.get_client_type() === Meta.WindowClientType.X11 ? 'x11' : 'wayland',
+            key,
+            title: window.get_title() ?? '',
+            seq: window.get_stable_sequence(),
+            monitor: monitorIndex,
+            workspace,
+            frame,
+            frameShare: share(frame, area),
+            floating,
+            floatingShare: share(floating, area),
+            state: windowState(window),
+            minimized: window.minimized,
+            above: window.is_above(),
+            sticky: window.is_on_all_workspaces() && !window.is_always_on_all_workspaces(),
+            focus: window === focus,
+            gtk: bus && path ? {bus, path} : null,
+        };
+    }
+
+    async _collectAppStates() {
+        if (this._clients.size === 0)
+            return new Map();
+        const serial = ++this._serial;
+        const answers = new Map();
+        this._answers = {serial, answers};
+        this._dbusImpl.emit_signal('SaveRequested', new GLib.Variant('(u)', [serial]));
+        await new Promise(resolve => {
+            const started = GLib.get_monotonic_time();
+            const id = GLib.timeout_add(GLib.PRIORITY_HIGH, 20, () => {
+                const done = answers.size >= this._clients.size;
+                if (done || GLib.get_monotonic_time() - started > SAVE_TIMEOUT_MS * 1000) {
+                    resolve();
+                    return GLib.SOURCE_REMOVE;
+                }
+                return GLib.SOURCE_CONTINUE;
+            });
+            this._answerWait = id;
+        });
+        this._answers = null;
+        return answers;
+    }
+
+    async collect(reason) {
+        const monitors = this._monitors();
+        const focus = global.display.focus_window;
+        const windows = this._windows().map(w => this._describe(w, monitors, focus));
+        const states = await this._collectAppStates();
+        const apps = new Map();
+        for (const w of windows) {
+            if (!w.app || apps.has(w.app))
+                continue;
+            apps.set(w.app, {app: w.app, windows: 0, state: null});
+        }
+        for (const w of windows) {
+            if (w.app)
+                apps.get(w.app).windows++;
+        }
+        for (const [bus, state] of states) {
+            const client = this._clients.get(bus);
+            if (!client)
+                continue;
+            const entry = [...apps.values()].find(a => sameApp(a.app, client.appId));
+            if (entry)
+                entry.state = variantToText(state);
+        }
+        const wm = global.workspace_manager;
+        return {
+            format: FORMAT,
+            id: GLib.uuid_string_random(),
+            device: this._device,
+            deviceName: GLib.get_host_name(),
+            deviceClass: GLib.getenv('LUMA_DEVICE_CLASS') || 'computer',
+            taken: Math.floor(Date.now() / 1000),
+            expires: Math.floor(Date.now() / 1000) + CONTINUE_TTL_S,
+            reason,
+            workspaces: {count: wm.get_n_workspaces(), active: wm.get_active_workspace_index()},
+            monitors,
+            windows,
+            apps: [...apps.values()],
+        };
+    }
+
+    async snapshot(reason) {
