+                    entry.app.open_new_window(-1);
+                } catch (e) {
+                    log(`${slot.app}: no new window: ${e.message}`);
+                }
+            }
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _checkRestoreDone() {
+        const restoring = this._restoring;
+        if (!restoring)
+            return;
