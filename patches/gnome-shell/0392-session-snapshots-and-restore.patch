+        const slots = (snapshot.windows ?? []).map((w, index) => ({...w, index, window: null}));
+        const restoring = {
+            snapshot, mode, base, monitorMap, current, slots,
+            started: GLib.get_monotonic_time(),
+            apps: new Map(),
+            result: {mode, windows: slots.length, placed: 0, missing: [], late: [], failed: []},
+        };
