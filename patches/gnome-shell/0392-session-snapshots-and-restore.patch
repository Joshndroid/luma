+        const current = this._monitors();
+        const monitorMap = mapMonitors(snapshot.monitors ?? [], current);
+        const busy = mode === 'continue' && this._windows().length > 0;
+        // Over an existing session, a new workspace after the last one.
+        let base = 0;
+        if (busy) {
+            base = wm.get_n_workspaces();
+            const last = wm.get_workspace_by_index(base - 1);
+            if (last && last.list_windows().filter(isRestorable).length === 0)
+                base -= 1;
+        }
+        const needed = base + Math.max(1, snapshot.workspaces?.count ?? 1);
+        while (wm.get_n_workspaces() < needed)
+            wm.append_new_workspace(false, global.get_current_time());
