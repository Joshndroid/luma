+    }
+
+    _windowCreated(window) {
+        this._markDirty();
+        if (!this._restoring && !this._late)
+            return;
+        window.connectObject('configure', (w, config) => {
+            if (config.get_is_initial())
+                this._configure(w, config);
+        }, this);
+    }
+
+    _slotFor(window) {
+        const restoring = this._restoring ?? this._late;
+        if (!restoring || !isRestorable(window))
+            return null;
+        const ids = candidateAppIds(window);
+        const open = restoring.slots.filter(s => !s.window && !s.missing &&
+            ((s.app && ids.has(s.app)) ||
+             (s.ids?.wmClass && ids.has(`${s.ids.wmClass}.desktop`)) ||
+             (s.ids?.sandboxed && ids.has(`${s.ids.sandboxed}.desktop`))));
