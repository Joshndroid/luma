+        // ordered, so a window mapping late can't land on top.
+        const active = global.workspace_manager.get_active_workspace();
+        if (restoring.slots.every(s => s.missing || (s.window &&
+            (s.shown || !s.window.located_on_workspace(active))))) {
+            if (this._restoreTimer)
+                GLib.source_remove(this._restoreTimer);
