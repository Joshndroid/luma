+        } catch (e) {
+            log(`no lid signal: ${e.message}`);
+        }
+    }
+
+    async _takeSleepInhibitor() {
+        if (this._sleepInhibitor)
+            return;
+        try {
+            this._sleepInhibitor = await LoginManager.getLoginManager().inhibit(
+                'Saving the open windows', null);
+        } catch (e) {
+            log(`no sleep inhibitor: ${e.message}`);
+        }
+    }
+
+    // --- restore ---------------------------------------------------------
+
+    _restoreAtLogin() {
+        if (!this.reopenWindows)
+            return;
+        const path = GLib.build_filenamev([this._dir, 'current.json']);
+        const snapshot = readJson(path);
