+            GLib.timeout_add(GLib.PRIORITY_DEFAULT, 300, () => {
+                this._finishRestore();
+                return GLib.SOURCE_REMOVE;
+            });
+        }
+    }
+
+    _finishRestore() {
+        const restoring = this._restoring;
+        if (!restoring)
+            return;
+        this._restoring = null;
+        const {slots, base, snapshot, result} = restoring;
+        // Bottom to top: each raise puts the window above the ones before it.
+        for (const slot of slots)
+            slot.window?.raise();
+        const wm = global.workspace_manager;
+        const active = base + (snapshot.workspaces?.active ?? 0);
+        // A fresh server time: a restore runs from a timeout, with no event
+        // whose time would let the activation through.
+        const time = global.display.get_current_time_roundtrip();
+        if (active < wm.get_n_workspaces() && active !== wm.get_active_workspace_index())
+            wm.get_workspace_by_index(active).activate(time);
+        const focus = slots.find(s => s.focus && s.window && !s.window.minimized);
+        if (focus) {
+            Main.activateWindow(focus.window, time);
+            // A client's own user time (an X11 client's, a startup token's)
+            // can be ahead of the server time and turn the activation into
+            // "demands attention". The person had this window focused.
+            if (global.display.focus_window !== focus.window)
+                focus.window.focus(time);
+            if (global.display.focus_window !== focus.window)
+                log(`${focus.app}: window ${focus.index} could not take the focus`);
+        }
