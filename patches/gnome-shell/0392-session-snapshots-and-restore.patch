+            return;
+        if (snapshot.device && snapshot.device !== this._device)
+            return;
+        if (this._windows().length > 0) {
+            log('windows already open, not restoring');
+            return;
+        }
+        snapshot.restoredAt = Math.floor(Date.now() / 1000);
+        try {
+            writePrivate(path, JSON.stringify(snapshot));
+        } catch (e) {
+            logError(e, '[luma-session] could not mark the session restored');
+            return;
+        }
+        this.restore(snapshot, 'restore');
+    }
+
+    restore(snapshot, mode) {
