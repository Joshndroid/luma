+            return null;
+        const bus = window.get_gtk_unique_bus_name();
+        const path = window.get_gtk_window_object_path();
+        const key = (bus && path && this._keys.get(`${bus}|${path}`)) || window.get_tag();
+        if (key) {
+            const keyed = open.find(s => s.key === key);
+            if (keyed)
+                return keyed;
+        }
+        const title = window.get_title() ?? '';
+        if (title) {
+            const exact = open.find(s => s.title === title);
+            if (exact)
+                return exact;
+        }
+        const unkeyed = open.filter(s => !s.key || !key);
+        const pool = unkeyed.length > 0 ? unkeyed : open;
+        return [...pool].sort((a, b) => a.seq - b.seq)[0];
+    }
+
+    _target(slot) {
+        const restoring = this._restoring ?? this._late;
+        const monitor = restoring.monitorMap.get(slot.monitor) ?? 0;
+        const savedMonitor = (restoring.snapshot.monitors ?? []).find(m => m.index === slot.monitor);
+        const currentMonitor = restoring.current.find(m => m.index === monitor) ?? restoring.current[0];
+        const area = currentMonitor.workArea;
+        const exact = savedMonitor && sameArea(savedMonitor.workArea, area) &&
+            savedMonitor.vendor === currentMonitor.vendor && savedMonitor.serial === currentMonitor.serial;
+        const floating = exact ? slot.floating : fit(unshare(slot.floatingShare, area), area);
+        const frame = exact ? slot.frame : fit(unshare(slot.frameShare, area), area);
+        return {monitor, area, floating, frame, exact};
+    }
+
+    _configure(window, config) {
+        const slot = this._slotFor(window);
+        if (!slot)
+            return;
+        const restoring = this._restoring ?? this._late;
+        slot.window = window;
+        restoring.result.placed++;
