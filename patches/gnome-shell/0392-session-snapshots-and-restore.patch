+            return null;
+        if (this._restoring)
+            return null;
+        const snapshot = await this.collect(reason);
+        const current = GLib.build_filenamev([this._dir, 'current.json']);
+        const previous = GLib.build_filenamev([this._dir, 'previous.json']);
+        try {
+            if (GLib.file_test(current, GLib.FileTest.EXISTS))
+                Gio.File.new_for_path(current).move(Gio.File.new_for_path(previous),
