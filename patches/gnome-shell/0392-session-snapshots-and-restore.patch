+            case 'maximized':
+                config.set_is_maximized?.(true);
+                break;
+            case 'tiled-left':
+                config.set_tile_side?.(Meta.Side.LEFT, target.monitor, 0);
+                break;
+            case 'tiled-right':
+                config.set_tile_side?.(Meta.Side.RIGHT, target.monitor, 0);
+                break;
+            case 'fullscreen':
+                config.set_is_fullscreen(true);
+                break;
+            }
+            if (slot.workspace < 0)
+                window.stick();
+            else
+                window.change_workspace_by_index(restoring.base + slot.workspace, false);
+        }
+        if (slot.above)
+            window.make_above();
+        if (slot.minimized)
+            window.minimize();
