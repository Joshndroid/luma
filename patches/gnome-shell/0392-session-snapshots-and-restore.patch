+                if (app.state === Shell.AppState.STOPPED) {
+                    app.launch(0, -1, Shell.AppLaunchGpu.APP_PREF);
+                } else if (!state) {
+                    app.open_new_window(-1);
+                }
+                restoring.apps.get(id).launched = 1;
+            } catch (e) {
