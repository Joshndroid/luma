+            this._notifyPartial(result);
+        this._markDirty();
+    }
+
+    _notifyPartial(result) {
+        const open = result.placed;
+        const source = MessageTray.getSystemSource();
+        const reasons = [];
+        if (result.missing.length)
+            reasons.push(`Not on this device: ${result.missing.map(id => this._appName(id)).join(', ')}`);
+        if (result.unplaced.length)
+            reasons.push(`Didn't open: ${result.unplaced.map(id => this._appName(id)).join(', ')}`);
+        const notification = new MessageTray.Notification({
+            source,
+            title: `Reopened ${open} of ${result.windows} windows`,
+            body: reasons.join('\n'),
+        });
+        source.addNotification(notification);
+    }
+
+    _appName(id) {
+        return Shell.AppSystem.get_default().lookup_app(id)?.get_name() ?? id.replace(/\.desktop$/, '');
+    }
+
+    // --- org.projectluma.Session1 ----------------------------------------
+
+    async TakeRestoreAsync([appId], invocation) {
+        try {
+            const caller = await callerIdentity(invocation.get_sender());
+            if (caller.appId && !sameApp(caller.appId, appId))
+                throw new Error(`${appId} is not the caller's app`);
+            if (caller.sandboxed && !caller.appId)
+                throw new Error('unidentified sandboxed caller');
+            this._addClient(invocation.get_sender(), appId);
+            const key = appId.replace(/\.desktop$/, '').toLowerCase();
+            const pending = this._pendingRestore.get(key);
+            this._pendingRestore.delete(key);
+            invocation.return_value(new GLib.Variant('(sv)', [
+                pending?.reason ?? 'none',
+                pending?.state ?? new GLib.Variant('a{sv}', {}),
+            ]));
+        } catch (e) {
+            invocation.return_error_literal(Gio.DBusError, Gio.DBusError.ACCESS_DENIED, e.message);
+        }
+    }
+
+    SetWindowKeyAsync([path, key], invocation) {
+        const sender = invocation.get_sender();
+        const id = `${sender}|${path}`;
+        if (key)
+            this._keys.set(id, key);
+        else
+            this._keys.delete(id);
+        invocation.return_value(null);
+    }
+
+    SaveStateAsync([serial, state], invocation) {
+        const sender = invocation.get_sender();
+        if (this._answers && this._answers.serial === serial && this._clients.has(sender))
+            this._answers.answers.set(sender, state);
+        invocation.return_value(null);
+    }
+
+    async _requireHost(invocation) {
+        const caller = await callerIdentity(invocation.get_sender());
+        if (caller.sandboxed || caller.appId)
+            throw new Error('only the system may read or apply sessions');
+    }
+
+    async SnapshotAsync([reason], invocation) {
+        try {
+            await this._requireHost(invocation);
+            const snapshot = await this.snapshot(reason || 'request');
+            invocation.return_value(new GLib.Variant('(s)', [JSON.stringify(snapshot ?? {})]));
+        } catch (e) {
+            invocation.return_error_literal(Gio.DBusError, Gio.DBusError.ACCESS_DENIED, e.message);
+        }
+    }
+
+    async GetSnapshotAsync(_params, invocation) {
+        try {
+            await this._requireHost(invocation);
+            const snapshot = readJson(GLib.build_filenamev([this._dir, 'current.json']));
+            invocation.return_value(new GLib.Variant('(s)', [JSON.stringify(snapshot ?? {})]));
+        } catch (e) {
+            invocation.return_error_literal(Gio.DBusError, Gio.DBusError.ACCESS_DENIED, e.message);
+        }
+    }
+
+    async RestoreAsync([text, mode], invocation) {
+        try {
+            await this._requireHost(invocation);
+            if (Main.sessionMode.isLocked)
+                throw new Error('the session is locked');
+            const snapshot = JSON.parse(text);
+            if (snapshot.format !== FORMAT)
+                throw new Error(`unknown snapshot format ${snapshot.format}`);
+            if (mode === 'continue' && snapshot.expires && snapshot.expires < Date.now() / 1000)
+                throw new Error('the snapshot has expired');
+            const result = this.restore(snapshot, mode === 'continue' ? 'continue' : 'restore');
+            invocation.return_value(new GLib.Variant('(s)', [JSON.stringify(result)]));
+        } catch (e) {
+            invocation.return_error_literal(Gio.DBusError, Gio.DBusError.FAILED, e.message);
+        }
+    }
+
+    _addClient(bus, appId) {
+        if (this._clients.has(bus))
+            return;
+        const watch = Gio.bus_watch_name_on_connection(Gio.DBus.session, bus,
+            Gio.BusNameWatcherFlags.NONE, null, () => {
+                Gio.bus_unwatch_name(watch);
+                this._clients.delete(bus);
+                for (const id of [...this._keys.keys()]) {
+                    if (id.startsWith(`${bus}|`))
+                        this._keys.delete(id);
+                }
+            });
+        this._clients.set(bus, {appId, watch});
+    }
+}
