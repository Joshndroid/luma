+        const byApp = new Map();
+        for (const slot of slots) {
+            const id = slot.app ?? `${slot.ids?.wmClass}.desktop`;
+            if (!byApp.has(id))
+                byApp.set(id, []);
+            byApp.get(id).push(slot);
+        }
+        const appSystem = Shell.AppSystem.get_default();
+        for (const [id, appSlots] of byApp) {
+            const app = appSystem.lookup_app(id);
+            if (!app) {
+                restoring.result.missing.push(id);
+                for (const slot of appSlots)
+                    slot.missing = true;
+                continue;
+            }
+            const appEntry = (snapshot.apps ?? []).find(a => a.app === id);
+            const state = textToVariant(appEntry?.state);
+            if (state)
+                this._pendingRestore.set(id.replace(/\.desktop$/, '').toLowerCase(),
+                    {reason: mode, state});
