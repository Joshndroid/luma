+        this._checkRestoreDone();
+    }
+
+    // An app that doesn't reopen its own windows opens one; once no new
+    // window of it has come for a moment, ask it for one more, until every
+    // window of it in the snapshot is there.
+    _openMoreWindows(slot) {
+        const restoring = this._restoring;
+        const entry = restoring?.apps.get(slot.app);
+        if (!entry || entry.lumaui)
+            return;
+        if (entry.moreId)
+            GLib.source_remove(entry.moreId);
