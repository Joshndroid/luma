+// Luma: where a window sits in a tile. A window that keeps its shape (an
+// app's aspect ratio lock) is the largest size with that shape, centred in
+// the tile, not the whole tile; Mutter says which
+// (meta_window_get_frame_rect_in_tile). Comparing its frame with the whole
+// tile would put it back in vain, and could make it look moved away.
+export function lumaFrameInTile(window, rect) {
+  try {
+    return window.get_frame_rect_in_tile?.(rect) ?? rect;
+  } catch (e) {
+    return rect;
+  }
+}
