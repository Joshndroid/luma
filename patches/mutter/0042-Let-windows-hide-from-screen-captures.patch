diff --git a/src/wayland/meta-wayland-window-capture.c b/src/wayland/meta-wayland-window-capture.c
new file mode 100644
index 0000000..e1d1d06
--- /dev/null
+++ b/src/wayland/meta-wayland-window-capture.c
@@ -0,0 +1,208 @@
+/*
+ * Copyright (C) 2026 Project Luma
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+
+/* luma_window_capture_v1: a client keeps its toplevel out of captures of
+ * the screen. The visibility is pending state of the wl_surface; the
+ * xdg_toplevel role hands it to its MetaWindow on commit. */
+
+#include "config.h"
+
+#include "wayland/meta-wayland-window-capture.h"
+
+#include "core/window-private.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "luma-window-capture-v1-server-protocol.h"
+
+static GQuark quark_window_capture = 0;
+
+typedef struct _MetaWaylandWindowCapture
+{
+  struct wl_resource *resource;
+  MetaWaylandSurface *surface;
+
+  gboolean has_pending;
+  gboolean pending_hidden;
+  gboolean hidden;
+} MetaWaylandWindowCapture;
+
+static void
+window_capture_surface_destroyed (gpointer data)
+{
+  MetaWaylandWindowCapture *capture = data;
+
+  capture->surface = NULL;
+}
+
+static void
+window_capture_destructor (struct wl_resource *resource)
+{
+  MetaWaylandWindowCapture *capture = wl_resource_get_user_data (resource);
+
+  if (capture->surface)
+    {
+      MetaWindow *window = meta_wayland_surface_get_window (capture->surface);
+
+      if (window && !window->unmanaging)
+        meta_window_set_hidden_from_capture (window, FALSE);
+
+      g_object_steal_qdata (G_OBJECT (capture->surface), quark_window_capture);
+    }
+
+  g_free (capture);
+}
+
+static void
+window_capture_destroy (struct wl_client   *client,
+                        struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+window_capture_set_visibility (struct wl_client   *client,
+                               struct wl_resource *resource,
+                               uint32_t            visibility)
+{
+  MetaWaylandWindowCapture *capture = wl_resource_get_user_data (resource);
+
+  switch (visibility)
+    {
+    case LUMA_WINDOW_CAPTURE_V1_VISIBILITY_VISIBLE:
+    case LUMA_WINDOW_CAPTURE_V1_VISIBILITY_HIDDEN:
+      break;
+    default:
+      wl_resource_post_error (resource,
+                              LUMA_WINDOW_CAPTURE_V1_ERROR_INVALID_VISIBILITY,
+                              "invalid visibility %u", visibility);
+      return;
+    }
+
+  capture->has_pending = TRUE;
+  capture->pending_hidden =
+    visibility == LUMA_WINDOW_CAPTURE_V1_VISIBILITY_HIDDEN;
+}
+
+static const struct luma_window_capture_v1_interface window_capture_interface = {
+  window_capture_destroy,
+  window_capture_set_visibility,
+};
+
+/**
+ * meta_wayland_window_capture_apply:
+ * @surface: the surface of an xdg_toplevel
+ * @window: its window
+ *
+ * Called by the xdg_toplevel role after a commit: applies a pending
+ * visibility, and the current one to a window that does not have it yet (a
+ * new window after the role was reset).
+ */
+void
+meta_wayland_window_capture_apply (MetaWaylandSurface *surface,
+                                   MetaWindow         *window)
+{
+  MetaWaylandWindowCapture *capture;
+
+  if (!quark_window_capture)
+    return;
+
+  capture = g_object_get_qdata (G_OBJECT (surface), quark_window_capture);
+  if (!capture)
+    return;
+
+  if (capture->has_pending)
+    {
+      capture->has_pending = FALSE;
+      capture->hidden = capture->pending_hidden;
+    }
+
+  /* Idempotent: nothing changes when the window already has it. */
+  meta_window_set_hidden_from_capture (window, capture->hidden);
+}
+
+static void
+window_capture_manager_destroy (struct wl_client   *client,
+                                struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+window_capture_manager_get_window_capture (struct wl_client   *client,
+                                           struct wl_resource *resource,
+                                           uint32_t            id,
+                                           struct wl_resource *surface_resource)
+{
+  MetaWaylandSurface *surface = wl_resource_get_user_data (surface_resource);
+  MetaWaylandWindowCapture *capture;
+
+  if (g_object_get_qdata (G_OBJECT (surface), quark_window_capture))
+    {
+      wl_resource_post_error (resource,
+                              LUMA_WINDOW_CAPTURE_MANAGER_V1_ERROR_ALREADY_CONSTRUCTED,
+                              "the wl_surface already has a luma_window_capture_v1");
+      return;
+    }
+
+  capture = g_new0 (MetaWaylandWindowCapture, 1);
+  capture->surface = surface;
+  capture->resource = wl_resource_create (client,
+                                          &luma_window_capture_v1_interface,
+                                          wl_resource_get_version (resource),
+                                          id);
+  wl_resource_set_implementation (capture->resource,
+                                  &window_capture_interface,
+                                  capture, window_capture_destructor);
+
+  g_object_set_qdata_full (G_OBJECT (surface), quark_window_capture,
+                           capture, window_capture_surface_destroyed);
+}
+
+static const struct luma_window_capture_manager_v1_interface window_capture_manager_interface = {
+  window_capture_manager_destroy,
+  window_capture_manager_get_window_capture,
+};
+
+static void
+bind_window_capture_manager (struct wl_client *client,
+                             void             *data,
+                             uint32_t          version,
+                             uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &luma_window_capture_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &window_capture_manager_interface,
+                                  data, NULL);
+}
+
+void
+meta_wayland_init_window_capture (MetaWaylandCompositor *compositor)
+{
+  quark_window_capture =
+    g_quark_from_static_string ("-meta-wayland-luma-window-capture");
+
+  if (wl_global_create (compositor->wayland_display,
+                        &luma_window_capture_manager_v1_interface,
+                        META_LUMA_WINDOW_CAPTURE_V1_VERSION,
+                        compositor, bind_window_capture_manager) == NULL)
+    g_error ("Failed to register a global luma_window_capture_manager_v1 object");
+}
