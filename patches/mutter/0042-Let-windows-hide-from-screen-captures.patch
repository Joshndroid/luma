+void
+meta_window_actor_set_hidden_from_capture (MetaWindowActor *self,
+                                           gboolean         hidden)
+{
+  MetaWindowActorPrivate *priv =
+    meta_window_actor_get_instance_private (self);
+  ClutterActor *actor = CLUTTER_ACTOR (self);
+
+  hidden = !!hidden;
+  if (clutter_actor_is_hidden_from_capture (actor) == hidden)
+    return;
+
+  clutter_actor_set_hidden_from_capture (actor, hidden);
+  meta_compositor_capture_hidden_actors_changed (priv->compositor,
+                                                 hidden ? 1 : -1);
+}
