+/* A window is hidden from capture if it asked, or if the window it is
+ * transient for is (a menu, a dialog). */
+static void
+update_capture_hidden (MetaWindow *window)
+{
+  GPtrArray *children;
+  gboolean hidden;
+  unsigned int i;
+
+  hidden = window->hidden_from_capture ||
+           (window->transient_for && window->transient_for->capture_hidden);
+  if (window->capture_hidden == hidden)
+    return;
+
+  meta_topic (META_DEBUG_SCREEN_CAST, "Window %s is %s capture",
+              window->desc, hidden ? "hidden from" : "shown in");
+
+  window->capture_hidden = hidden;
+  meta_compositor_window_hidden_from_capture_changed (window->display->compositor,
+                                                      window);
+  g_object_notify_by_pspec (G_OBJECT (window),
+                            obj_props[PROP_HIDDEN_FROM_CAPTURE]);
+
+  children = meta_window_get_transient_children (window);
+  for (i = 0; children && i < children->len; i++)
+    update_capture_hidden (g_ptr_array_index (children, i));
+}
+
+/**
+ * meta_window_set_hidden_from_capture:
+ * @window: a #MetaWindow
+ * @hidden: whether captures of the screen leave the window out
+ *
+ * A window hidden from capture stays on the screen but is left out of
+ * screen casts of monitors and areas and out of screenshots of the screen,
+ * with the windows transient for it. Recording or capturing the window
+ * itself is not affected. Hiding only removes content from captures, so it
+ * needs no permission.
+ */
+void
+meta_window_set_hidden_from_capture (MetaWindow *window,
+                                     gboolean    hidden)
+{
+  g_return_if_fail (META_IS_WINDOW (window));
+
+  hidden = !!hidden;
+  if (window->hidden_from_capture == hidden)
+    return;
+
+  window->hidden_from_capture = hidden;
+  update_capture_hidden (window);
+}
+
+/**
+ * meta_window_is_hidden_from_capture:
+ * @window: a #MetaWindow
+ *
+ * Returns: %TRUE if captures of the screen leave @window out, because it
+ *   or the window it is transient for is hidden from capture
+ */
+gboolean
+meta_window_is_hidden_from_capture (MetaWindow *window)
+{
+  g_return_val_if_fail (META_IS_WINDOW (window), FALSE);
+
+  return window->capture_hidden;
+}
+
 void
