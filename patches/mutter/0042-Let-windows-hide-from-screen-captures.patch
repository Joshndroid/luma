+void
+meta_compositor_window_hidden_from_capture_changed (MetaCompositor *compositor,
+                                                    MetaWindow     *window)
+{
+  MetaWindowActor *window_actor;
+
+  window_actor = meta_window_actor_from_window (window);
+  if (!window_actor)
+    return;
+
+  meta_window_actor_set_hidden_from_capture (window_actor,
+                                             window->capture_hidden);
+}
+
+void
+meta_compositor_capture_hidden_actors_changed (MetaCompositor *compositor,
+                                               int             delta)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+
+  priv->n_capture_hidden_actors += delta;
+  g_warn_if_fail (priv->n_capture_hidden_actors >= 0);
+}
+
+/**
+ * meta_compositor_is_capture_hidden_in:
+ * @compositor: a #MetaCompositor
+ * @rect: an area of the stage, in stage coordinates
+ *
+ * Whether a capture of @rect must paint the stage rather than copy the
+ * screen, because a window hidden from capture is on screen there or is
+ * shown through a clone anywhere. With no window hidden from capture this
+ * is a counter check.
+ *
+ * Returns: %TRUE if a capture of @rect must leave something on screen out
+ */
+gboolean
+meta_compositor_is_capture_hidden_in (MetaCompositor     *compositor,
+                                      const MtkRectangle *rect)
+{
+  MetaCompositorPrivate *priv =
+    meta_compositor_get_instance_private (compositor);
+  GList *l;
+
+  if (priv->n_capture_hidden_actors == 0)
+    return FALSE;
+
+  for (l = priv->windows; l; l = l->next)
+    {
+      ClutterActor *actor = l->data;
+      MetaSurfaceActor *surface_actor;
+      graphene_rect_t extents;
+      MtkRectangle actor_rect;
+
+      if (!clutter_actor_is_hidden_from_capture (actor))
+        continue;
+
+      /* Clones (the overview, window switchers) of the window or of its
+       * surface show it wherever they are, mapped or not. */
+      surface_actor = meta_window_actor_get_surface (META_WINDOW_ACTOR (actor));
+      if (clutter_actor_has_mapped_clones (surface_actor ?
+                                           CLUTTER_ACTOR (surface_actor) :
+                                           actor))
+        return TRUE;
+
+      if (!clutter_actor_is_mapped (actor))
+        continue;
+
+      clutter_actor_get_transformed_extents (actor, &extents);
+      mtk_rectangle_from_graphene_rect (&extents,
+                                        MTK_ROUNDING_STRATEGY_GROW,
+                                        &actor_rect);
+      if (mtk_rectangle_overlap (&actor_rect, rect))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
 void
 meta_compositor_window_opacity_changed (MetaCompositor *compositor,
                                         MetaWindow     *window)
