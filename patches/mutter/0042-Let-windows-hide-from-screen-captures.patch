+/**
+ * clutter_actor_set_hidden_from_capture:
+ * @self: a #ClutterActor
+ * @hidden: whether captures of the stage leave the actor out
+ *
+ * An actor hidden from capture, with its children, is painted on the screen
+ * as usual but not in paints carrying %CLUTTER_PAINT_FLAG_CAPTURE (screen
+ * casts and screenshots of the stage), including paints of it through a
+ * #ClutterClone. Painting the actor itself, outside a paint of the stage,
+ * is not affected.
+ */
+void
+clutter_actor_set_hidden_from_capture (ClutterActor *self,
+                                       gboolean      hidden)
+{
+  g_return_if_fail (CLUTTER_IS_ACTOR (self));
+
+  hidden = !!hidden;
+  if (self->priv->hidden_from_capture == hidden)
+    return;
+
+  self->priv->hidden_from_capture = hidden;
+  self->priv->context->n_capture_hidden_actors += hidden ? 1 : -1;
+
+  /* A capture following the screen records a new frame with the paint. */
+  clutter_actor_queue_redraw (self);
+}
+
+/**
+ * clutter_actor_is_hidden_from_capture:
+ * @self: a #ClutterActor
+ *
+ * Returns: %TRUE if clutter_actor_set_hidden_from_capture() hid the actor
+ */
+gboolean
+clutter_actor_is_hidden_from_capture (ClutterActor *self)
+{
+  g_return_val_if_fail (CLUTTER_IS_ACTOR (self), FALSE);
+
+  return self->priv->hidden_from_capture;
+}
+
+/* Whether any actor is hidden from capture: until one is, captures of the
+ * stage paint exactly what the screen shows. */
+gboolean
+_clutter_context_has_capture_hidden_actors (ClutterContext *context)
+{
+  return context->n_capture_hidden_actors > 0;
+}
+
+/* Whether @self or an ancestor is hidden from capture: a clone paints its
+ * source without the source's ancestors. */
+gboolean
+_clutter_actor_is_in_hidden_from_capture_branch (ClutterActor *self)
+{
+  ClutterActor *actor;
+
+  for (actor = self; actor; actor = actor->priv->parent)
+    {
+      if (actor->priv->hidden_from_capture)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
 static void
 push_in_paint_unmapped_branch (ClutterActor *self,
                                guint         count)
