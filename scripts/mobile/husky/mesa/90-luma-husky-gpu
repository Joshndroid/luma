#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# systemd user environment generator: point user sessions (GNOME Shell, the
# login screen, apps) at the private Mesa in /var/lib/luma-husky/mesa when it
# is installed. `touch /var/lib/luma-husky/gpu-off` falls back to software
# rendering. GTK stays on GL: the system Vulkan loader would pick lavapipe.
m=/var/lib/luma-husky/mesa
[ -f $m/BUILD-INFO ] && [ -f $m/share/glvnd/egl_vendor.d/50_mesa.json ] || exit 0
[ -e /var/lib/luma-husky/gpu-off ] && exit 0
echo "LD_LIBRARY_PATH=$m/lib64"
echo "__EGL_VENDOR_LIBRARY_FILENAMES=$m/share/glvnd/egl_vendor.d/50_mesa.json"
echo "GBM_BACKENDS_PATH=$m/lib64/gbm"
echo "LIBGL_DRIVERS_PATH=$m/lib64/dri"
echo "GSK_RENDERER=ngl"
echo "GDK_DISABLE=vulkan"
# Flatpak apps get the same Mesa through the GL extension that
# flatpak-gl-extension builds from the prefix (once it matches the prefix).
e=/var/lib/flatpak/extension/org.projectluma.Platform.GL.luma-husky/aarch64/44
if [ "$(cat $m/BUILD-INFO)" = "$(cat $e/BUILD-INFO 2>/dev/null)" ]; then
	echo "FLATPAK_GL_DRIVERS=luma-husky"
fi
