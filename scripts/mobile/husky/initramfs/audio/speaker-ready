#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Luma husky: the UCM speaker route runs this before it unmutes.
# Refuse unless speaker-calibrate armed the amplifiers' protection this boot,
# then set both amplifiers to this phone's factory volumes (persist
# audio/speaker.cal, as the stock build plays): analog 0..31 steps of 1 dB,
# digital 0..913 in 0.125 dB steps where 817 is 0 dB.
d=/run/luma-husky-audio
r=$d/speaker-calibration.json g=$d/speaker-gains
for f in "$r" "$g"; do
	[ -f "$f" ] && [ ! -L "$f" ] && [ "$(stat -c %u "$f")" = 0 ] || exit 1
done
grep -q '"both_unit_calibrations_selected": true' "$r" &&
	grep -q '"protection_errors": false' "$r" || exit 1
read -r la ld ra rd extra < "$g" || exit 1
[ -z "$extra" ] || exit 1
for v in "$la" "$ld" "$ra" "$rd"; do
	case $v in '' | *[!0-9]*) exit 1 ;; esac
done
[ "$la" -le 31 ] && [ "$ra" -le 31 ] && [ "$ld" -le 913 ] && [ "$rd" -le 913 ] || exit 1
set_amp() {
	/usr/bin/amixer -q -c aocaudio cset "name=$1Analog PCM Volume" "$2" &&
		/usr/bin/amixer -q -c aocaudio cset "name=$1Digital PCM Volume" "$3"
}
set_amp '' "$la" "$ld" && set_amp 'R ' "$ra" "$rd"
